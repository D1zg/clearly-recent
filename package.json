{
  "name": "clearly-recent",
  "version": "1.0.0",
  "description": "Hides uninstalled games from Recent Games on the Steam Deck Home screen.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "release": "python3 scripts/package.py"
  },
  "keywords": [
    "steam-deck",
    "decky-loader",
    "decky-plugin",
    "steam",
    "steamui"
  ],
  "author": "Dizg",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.0.0",
    "@types/react-router": "5.1.20"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "packageManager": "pnpm@9.15.9"
}
